# Gemini API Key (Server-Side Only - Never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Configuration
PORT=8000
HOST=0.0.0.0
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# CORS Allowed Origins (Comma-separated for React/Vite dev and Vercel production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.vercel.app
